---
layout: layout.liquid
navigationOptions:
  includeSelf: true
---

{{ collections.all | eleventyNavigation | eleventyNavigationToHtml: navigationOptions }}

<h1>{{ title }}</h1>

<p class="post-meta">
  Publié le {{ date | niceDate }}
</p>

{% if page.data.image %}
<img src="{{ page.data.image }}" alt="{{ title }}" class="blog-post-image">
{% endif %}

<div class="post-content">
  {{ content }}
</div>

{% if page.data.tags %}
<p class="post-tags">
  {% for tag in page.data.tags %}
    <span class="tag">{{ tag }}</span>
  {% endfor %}
  </p>
{% endif %}