<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="color-scheme" content="light dark">

        <script>
            // Appliquer immédiatement le thème sauvegardé (avant paint)
            (function () {
            const theme = localStorage.getItem('theme');
            if (theme) {
                document.documentElement.setAttribute('data-theme', theme);
            }
            document.documentElement.classList.add('no-transitions');
            })();
        </script>

        <link rel="stylesheet" href="/bundle.css">

        <!-- Favicon -->
        <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />

        <title>Alexis POUPELIN | {{ title }}</title>
        <meta name="description" content="{{ description }}">

        <!-- Privacy-friendly analytics by Plausible -->
        <script async src="https://plausible.io/js/pa-W8pPcrUUdVdnAdbpS71Dq.js"></script>
        <script>
        window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
        plausible.init()
        </script>
    </head>
    <body>
        <header class="container">
            <nav style="flex-wrap: wrap">
                <ul>
                    <li>
                        <a href="/">
                            <strong># Alexis POUPELIN</strong><br>
                            <small style="color: var(--pico-muted-color);">Full Stack, DevOps, SRE & Sécurité</small>
                        </a>
                    </li>
                </ul>
                <ul>
                    <li><a href="/mes-competences" class="secondary">Compétences</a></li>
                    <li><a href="/mes-experiences" class="secondary">Expériences</a></li>
                    <li><a href="/mes-projets" class="secondary">Projets</a></li>
                    <li>
                        <button class="theme-switcher" id="theme-toggle" aria-label="Basculer le thème" title="Changer de thème">
                            <span class="icon icon-light">☀️</span>
                            <span class="icon icon-dark">🌙</span>
                            <span class="label">Thème</span>
                        </button>
                    </li>
                </ul>
            </nav>
        </header>
        <main class="container">
            {{ content }}
        </main>
        <footer>
            <a href="/mentions-legales">Mentions légales</a>
        </footer>
    </body>
    <script src="/bundle.js"></script>
</html>