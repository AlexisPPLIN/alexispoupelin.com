---
layout: layout.liquid
pagination:
  data: collections.post
  size: 2
  alias: posts
  reverse: true
---

<h1>Archives des articles</h1>

{% for post in posts %}
<article class="blog-post">
  <h2><a href="{{post.url}}">{{ post.data.title }}</a></h2>
  <p class="post-meta">
    Publié le {{ post.date | niceDate }}
  </p>
  {% if post.data.image %}
  <img src="{{ post.data.image }}" alt="{{ post.data.title }}" class="blog-post-image">
  {% endif %}
  <p class="post-excerpt">
    {% excerpt post %}
  </p>
  {% if post.data.tags %}
  <p class="post-tags">
    {% for tag in post.data.tags %}
      <span class="tag">{{ tag }}</span>
    {% endfor %}
  </p>
  {% endif %}
</article>
{% endfor %}

<nav class="pagination">
  {% if pagination.href.previous %}
    <a href="{{ pagination.href.previous }}">Précédent</a>
  {% else %}
    Précédent
  {% endif %} 
  /
  {% if pagination.href.next %}
    <a href="{{ pagination.href.next }}">Suivant</a>
  {% else %}
    Suivant
  {% endif %}
</nav>
