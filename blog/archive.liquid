---
layout: layout.liquid
pagination:
  data: collections.post
  size: 2
  alias: posts
  reverse: true
---

<h1 class="blog-page-title">Archives</h1>
<p class="blog-page-subtitle">Tous les articles, plus anciens d'abord</p>

<div class="blog-grid">
  {% for post in posts %}
  <article class="blog-card{% if not post.data.image %} no-image{% endif %}">
    {% if post.data.image %}
    <a href="{{ post.url }}" class="blog-card-image-wrapper">
      <img src="{{ post.data.image }}" alt="{{ post.data.title }}" class="blog-card-image">
    </a>
    {% endif %}
    <div class="blog-card-body">
      <a href="{{ post.url }}" class="card-link">
        <h2 class="blog-card-title">{{ post.data.title }}</h2>
        <p class="blog-card-meta">{{ post.date | niceDate }}</p>
        <p class="blog-card-excerpt">{% excerpt post %}</p>
        {% if post.data.tags %}
        <div class="blog-card-footer">
          {% for tag in post.data.tags %}
          <span class="tag">{{ tag }}</span>
          {% endfor %}
        </div>
        {% endif %}
      </a>
    </div>
  </article>
  {% endfor %}
</div>

<nav class="pagination">
  {% if pagination.href.previous %}
  <a href="{{ pagination.href.previous }}">← Précédent</a>
  {% else %}
  <span class="separator">← Précédent</span>
  {% endif %}

  <span class="separator">/</span>

  {% if pagination.href.next %}
  <a href="{{ pagination.href.next }}">Suivant →</a>
  {% else %}
  <span class="separator">Suivant →</span>
  {% endif %}
</nav>

<a href="/blog/" class="back-to-blog">Retour au blog</a>