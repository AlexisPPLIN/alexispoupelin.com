---
layout: layout.liquid
title: Blog
description: Articles de blog
---

<h1 class="blog-page-title">Articles de blog</h1>
<p class="blog-page-subtitle">Mes derniers articles et réflexions</p>

<div class="blog-grid">
  {% for post in collections.post reversed %}
  <article class="blog-card{% if not post.data.image %} no-image{% endif %}">
    {% if post.data.image %}
    <a href="{{ post.url }}" class="blog-card-image-wrapper">
      <img src="{{ post.data.image }}" alt="{{ post.data.title }}" class="blog-card-image">
    </a>
    {% endif %}
    <div class="blog-card-body">
      <a href="{{ post.url }}" class="card-link">
        <h2 class="blog-card-title">{{ post.data.title }}</h2>
        <p class="blog-card-meta">{{ post.date | niceDate }}</p>
        <p class="blog-card-excerpt">{% excerpt post %}</p>
        {% if post.data.tags %}
        <div class="blog-card-footer">
          {% for tag in post.data.tags %}
          <span class="tag">{{ tag }}</span>
          {% endfor %}
        </div>
        {% endif %}
      </a>
    </div>
  </article>
  {% endfor %}
</div>