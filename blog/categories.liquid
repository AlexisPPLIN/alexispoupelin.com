---
layout: layout.liquid
pagination:
  data: collections.categories
  size: 1
  alias: category
permalink: "/blog/categories/{{ category | slugify }}/index.html"
---

<h1 class="blog-page-title">Articles : {{ category }}</h1>
<p class="blog-page-subtitle">Tous les articles de la catégorie {{ category }}</p>

{% assign posts = collections.post | filterByCategory: category %}

{% if posts.size > 0 %}
<div class="blog-grid">
  {% for post in posts reversed %}
  <article class="blog-card{% if not post.data.image %} no-image{% endif %}">
    {% if post.data.image %}
    <a href="{{ post.url }}" class="blog-card-image-wrapper">
      <img src="{{ post.data.image }}" alt="{{ post.data.title }}" class="blog-card-image">
    </a>
    {% endif %}
    <div class="blog-card-body">
      <a href="{{ post.url }}" class="card-link">
        <h2 class="blog-card-title">{{ post.data.title }}</h2>
        <p class="blog-card-meta">{{ post.date | niceDate }}</p>
        <p class="blog-card-excerpt">{% excerpt post %}</p>
        {% if post.data.tags %}
        <div class="blog-card-footer">
          {% for tag in post.data.tags %}
          <span class="tag">{{ tag }}</span>
          {% endfor %}
        </div>
        {% endif %}
      </a>
    </div>
  </article>
  {% endfor %}
</div>
{% else %}
<p>Aucun article dans cette catégorie pour le moment.</p>
{% endif %}

<a href="/blog/" class="back-to-blog">Retour au blog</a>